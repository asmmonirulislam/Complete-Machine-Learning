df.head()


df['Sex'] = df['Sex'].map({'M':1, 'F':0})


df['ExerciseAngina'] = df['ExerciseAngina'].map({'N':0, 'Y':1})


df = df.rename(columns={
    'Sex':'is_male',
    'ExerciseAngina':'has_exercise_angina'
})


df = pd.get_dummies(df, columns=['ChestPainType', 'RestingECG', 'ST_Slope'])


df = df.astype(int)


df.head()





from sklearn.preprocessing import StandardScaler


num_cols.extend(['Oldpeak'])


scaler = StandardScaler()
df[num_cols] = scaler.fit_transform(df[num_cols])

df.head()





from scipy.stats import pearsonr


features = [col for col in df.columns if col != 'HeartDisease']

correlation = {}

for feature in features:
    correlation[feature] = pearsonr(df[feature], df['HeartDisease'])[0]

df_corr = pd.DataFrame(
    correlation.items(),
    columns=['feature', 'correlation']
).sort_values(
    by='correlation',
    ascending=False
).reset_index(drop=True)

df_corr



