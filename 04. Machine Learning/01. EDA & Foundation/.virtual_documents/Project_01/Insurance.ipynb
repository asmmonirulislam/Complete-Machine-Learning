df_cleaned = df.copy()





df_cleaned.head()


df_cleaned.shape


df_cleaned.drop_duplicates(inplace=True)


df_cleaned.shape





df_cleaned.isnull().sum()





df_cleaned.isnull().mean() * 100





df_cleaned = df_cleaned.dropna()


df_cleaned.shape





df['smoker'].value_counts()





df_cleaned['smoker'] = df_cleaned['smoker'].map({'yes':1, 'no':0})


df_cleaned.head()


df_cleaned['sex'].value_counts()





df_cleaned['sex'] = df_cleaned['sex'].map({'male':1, 'female':0})


df_cleaned





df_cleaned = df_cleaned.rename(columns={
    'sex':'is_male',
    'smoker':'is_smoker'
})

df_cleaned


df_cleaned['region'].value_counts()





df_cleaned = pd.get_dummies(df_cleaned, columns=['region'])
df_cleaned


region_cols = [col for col in df_cleaned.columns if col.startswith('region_')]
df_cleaned[region_cols] = df_cleaned[region_cols].astype(int)


df_cleaned








df_cleaned['bmi_category'] = pd.cut(
    df_cleaned['bmi'],
    bins = [0, 18.5, 25, 30, 35, 40, float('inf')],
    labels = ['underweight', 'normal', 'overweight', 'obesity_1', 'obesity_2', 'severe']
)


df_cleaned


df_cleaned.groupby('bmi_category')['bmi'].agg(['min', 'max'])


df_cleaned = pd.get_dummies(df_cleaned, columns=['bmi_category'])


df_cleaned


df_cleaned.columns


bmi_cols = df_cleaned.filter(like='bmi_category_').columns

df_cleaned[bmi_cols] = df_cleaned[bmi_cols].astype(int)


df_cleaned





scaler = StandardScaler()
cols = ['age', 'bmi', 'children']
df_cleaned[cols] = scaler.fit_transform(df_cleaned[cols])


df_cleaned.head()





features = [col for col in df_cleaned.columns if col != 'charges']
correlation = {}
for feature in features:
    correlation[feature]=pearsonr(df_cleaned[feature], df_cleaned['charges'])[0]
df_corr = pd.DataFrame(correlation.items(), columns=['feature', 'pearson_correlation']).sort_values(by='pearson_correlation', ascending=False).reset_index(drop=True)


df_corr





cat_cols = [col for col in df_cleaned.columns if col not in num_cols]
cat_cols


alpha = 0.05

chi2_result = {}

df_cleaned['charges_bins'] = pd.qcut(df['charges'], q=4, labels=False)

for col in cat_cols:
    contingency = pd.crosstab(df_cleaned[col], df_cleaned['charges_bins'])
    chi2_stat, p_val, _, _ = chi2_contingency(contingency)

    chi2_result[col] = {
        'chi2_statistics':chi2_stat,
        'p_value':p_val,
        'decision':'Reject Null (Keep Feature)' if p_val<alpha else 'Accept Null (Drop Feature)',
        'keep_feature':True if p_val<alpha else False
    }


df_chi2 = pd.DataFrame(chi2_result).T
df_chi2


num_cols


final_cols = num_cols+[col for col, result in chi2_result.items() if result['keep_feature']]
final_cols


final_df = df_cleaned[final_cols]
final_df



